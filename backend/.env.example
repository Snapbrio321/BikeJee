# Copy to .env and fill in. Never commit .env.
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# SMS provider — pick ONE
# Option A: MSG91 (India) — https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BIKEJEE

# Option B: AWS SNS (uses your AWS server's IAM role or keys)
AWS_REGION=ap-south-1
# If not using an EC2 IAM role, set keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Which provider to use: msg91 | sns | console (console = log OTP for testing)
SMS_PROVIDER=console

# Razorpay (payments) — leave empty for mock mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
