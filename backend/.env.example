# Copy to .env and fill in. Never commit .env.
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Local docker-compose: postgres://bikejee:bikejee@postgres:5432/bikejee
# AWS RDS:              postgres://USER:PASS@your-rds-endpoint:5432/bikejee
DATABASE_URL=postgres://bikejee:bikejee@localhost:5432/bikejee
PG_POOL_MAX=20
# Set to 'true' for AWS RDS (requires SSL), 'false' for local docker
PG_SSL=false

# ── Redis (cache / OTP / geo / socket adapter) ────────────────────────
# Local docker-compose: redis://redis:6379
# AWS ElastiCache:      redis://your-elasticache-endpoint:6379
REDIS_URL=redis://localhost:6379

# ── Scaling / networking ──────────────────────────────────────────────
# PM2 workers per instance ('max' = one per CPU core)
PM2_INSTANCES=max
# Restrict CORS in production to your web app origin(s)
CORS_ORIGIN=*

# SMS provider — pick ONE
# Option A: MSG91 (India) — https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BIKEJEE

# Option B: AWS SNS (uses your AWS server's IAM role or keys)
AWS_REGION=ap-south-1
# If not using an EC2 IAM role, set keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Which provider to use: msg91 | sns | console (console = log OTP for testing)
SMS_PROVIDER=console

# Razorpay (payments) — leave empty for mock mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
