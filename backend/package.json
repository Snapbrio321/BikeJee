{
  "name": "bikejee-backend",
  "version": "2.0.0",
  "description": "BikeJee ride-hailing backend — production-scale (Postgres + Redis + clustering)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cluster": "pm2 start ecosystem.config.cjs",
    "migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.670.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "express-rate-limit": "^7.4.1",
    "rate-limit-redis": "^4.2.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "pm2": "^5.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
